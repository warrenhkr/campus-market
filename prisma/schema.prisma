// schema.prisma - Campus Market

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum UserRole {
  USER
  SELLER
  ADMIN

  @@map("user_role")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("verification_status")
}

enum SubscriptionPlan {
  DECOUVERTE
  STARTER
  BUSINESS
  PRO

  @@map("subscription_plan")
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
  SHIPPED
  DELIVERED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum ProductStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  HIDDEN

  @@map("product_status")
}

enum ProductType {
  PHYSICAL
  DIGITAL

  @@map("product_type")
}

enum ProductCtaStyle {
  PRIMARY
  SECONDARY

  @@map("product_cta_style")
}

enum StockMode {
  UNLIMITED
  TRACKED
  PREORDER
  OUT_OF_STOCK

  @@map("stock_mode")
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("support_ticket_status")
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("support_ticket_priority")
}

enum SupportTicketCategory {
  TECHNICAL
  BILLING
  ACCOUNT
  DISPUTE
  OTHER

  @@map("support_ticket_category")
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum SystemAlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL

  @@map("system_alert_severity")
}

// --- MODELS ---

model User {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email              String   @unique
  name               String?
  avatar_url         String?
  phone              String?
  university         String?
  faculty            String?
  etablissement_type String?  @default("public")
  filiere            String?
  account_type       String?  @default("student")
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)
  role               UserRole @default(USER)

  seller                    Seller?
  orders                    Order[]
  reviews                   Review[]
  favorites                 Favorite[]
  notifications             Notification[]
  admin_logs                AdminLog[]
  support_tickets_requested SupportTicket[]      @relation("TicketRequester")
  support_tickets_assigned  SupportTicket[]      @relation("TicketAssignee")
  support_ticket_replies    SupportTicketReply[]
  reports_created           Report[]             @relation("ReportCreator")
  reports_resolved          Report[]             @relation("ReportResolver")
  uploaded_media            StoreMedia[]

  @@map("users")
}

model Category {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String    @unique
  slug       String    @unique
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  products   Product[]

  @@map("categories")
}

model Seller {
  id                      String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id                 String             @unique @db.Uuid
  shop_name               String             @unique
  description             String?
  verification_status     VerificationStatus @default(PENDING)
  subscription_plan       SubscriptionPlan   @default(DECOUVERTE)
  subscription_expires_at DateTime?          @db.Timestamptz(6)
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  updated_at              DateTime           @default(now()) @db.Timestamptz(6)

  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  shops      Shop[]
  reports    Report[]
  withdrawals Withdrawal[]

  @@map("sellers")
}

model Shop {
  id                      String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seller_id               String       @db.Uuid
  name                    String
  slug                    String       @unique
  description             String?
  email                   String?
  phone                   String?
  image_url               String?
  logo_url                String?
  banner_url              String?
  favicon_url             String?
  contact_name            String?
  contact_phone           String?
  whatsapp_url            String?
  facebook_url            String?
  instagram_url           String?
  tiktok_url              String?
  youtube_url             String?
  website_url             String?
  og_image_url            String?
  og_image_public_id      String?
  og_image_media_id       String?      @db.Uuid
  logo_media_id           String?      @db.Uuid
  banner_media_id         String?      @db.Uuid
  favicon_media_id        String?      @db.Uuid
  currency                String?      @default("XOF")
  language                String?      @default("fr")
  timezone                String?      @default("Africa/Porto-Novo")
  status                  String?      @default("ACTIVE")
  primary_color           String?
  secondary_color         String?
  accent_color            String?
  background_color        String?
  text_color              String?
  show_banner             Boolean?     @default(true)
  show_categories         Boolean?     @default(true)
  show_featured_products  Boolean?     @default(true)
  show_new_products       Boolean?     @default(true)
  show_reviews            Boolean?     @default(true)
  show_contact            Boolean?     @default(true)
  show_social_links       Boolean?     @default(true)
  delivery_enabled        Boolean?     @default(false)
  delivery_fee            Decimal?     @db.Decimal(10, 2)
  free_delivery_threshold Decimal?     @db.Decimal(10, 2)
  pickup_enabled          Boolean?     @default(true)
  campus_delivery_enabled Boolean?     @default(true)
  local_delivery_enabled  Boolean?     @default(false)
  allow_guest_checkout    Boolean?     @default(true)
  allow_cancellation      Boolean?     @default(true)
  meta_title              String?
  meta_description        String?
  created_at              DateTime     @default(now()) @db.Timestamptz(6)
  updated_at              DateTime     @default(now()) @db.Timestamptz(6)
  products                Product[]
  media                   StoreMedia[]
  payment_splits          PaymentSplit[]

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("shops")
}

model Product {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shop_id        String          @db.Uuid
  category_id    String?         @db.Uuid
  name           String
  slug           String?         // unique par (shop_id, slug) — index partiel géré en SQL brut (migration), pas via @@unique Prisma (Prisma 5.x ne supporte pas les index uniques partiels dans le schéma)
  description    String?
  price          Decimal         @db.Decimal(10, 2)
  original_price Decimal?        @db.Decimal(10, 2)
  promo_label    String?
  promo_start_at DateTime?
  promo_end_at   DateTime?
  promo_auto_renew Boolean       @default(false)
  cta_text       String?
  cta_url        String?
  cta_style      ProductCtaStyle @default(PRIMARY)
  image_url      String?
  stock          Int             @default(0)
  stock_mode     StockMode       @default(TRACKED)
  low_stock_threshold Int?
  allow_backorder Boolean        @default(false)
  is_available   Boolean         @default(true)
  // Visibilité et exclusivité (inspiré des options "création de produit" de référence)
  is_hidden_from_shop  Boolean   @default(false)
  hide_sales_count     Boolean   @default(false)
  sales_limit          Int?
  // Réapprovisionnement automatique : quand stock <= restock_threshold,
  // stock += restock_quantity (déclenché par le webhook de paiement, pas ici)
  restock_threshold    Int?
  restock_quantity     Int?
  // Post-achat et protection (produits numériques)
  post_purchase_instructions String?
  require_shipping_address   Boolean @default(false)
  file_password               String?
  watermark_files              Boolean @default(false)
  // SEO dédié à la fiche produit (distinct de metadata.seo existant, gardé pour compat)
  seo_title       String?
  seo_description String?
  seo_thumbnail_url String?
  seo_keywords    String?
  metadata       Json            @default("{}")
  status         ProductStatus   @default(APPROVED)
  type           ProductType     @default(PHYSICAL)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)

  order_items    OrderItem[]
  reviews        Review[]
  reports        Report[]
  favorites      Favorite[]
  variants       ProductVariant[]
  delivery_zones ProductDeliveryZone[]
  faqs           ProductFaq[]
  pricing_tiers  ProductPricingTier[]
  shop           Shop        @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  category       Category?   @relation(fields: [category_id], references: [id], onDelete: SetNull)

  @@map("products")
}

enum ProductFaqLayout {
  ACCORDION
  GRID
  LIST

  @@map("product_faq_layout")
}

model ProductFaq {
  id          String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id  String            @db.Uuid
  question    String
  answer      String
  is_published Boolean          @default(true)
  layout      ProductFaqLayout  @default(ACCORDION)
  position    Int               @default(0)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime          @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_faqs")
}

model ProductPricingTier {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id  String   @db.Uuid
  label       String
  price       Decimal  @db.Decimal(10, 2)
  is_default  Boolean  @default(false)
  position    Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_pricing_tiers")
}

model ProductVariant {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id   String   @db.Uuid
  name         String
  price_delta  Decimal  @default(0) @db.Decimal(10, 2)
  stock_delta  Int      @default(0)
  sku          String?
  is_active    Boolean  @default(true)
  position     Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  product     Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order_items OrderItem[]

  @@index([product_id])
  @@map("product_variants")
}

model ProductDeliveryZone {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id          String   @db.Uuid
  name                String
  fee                 Decimal? @db.Decimal(10, 2)
  estimated_min_days  Int?
  estimated_max_days  Int?
  is_active           Boolean  @default(true)
  position            Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_delivery_zones")
}

model Favorite {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String   @db.Uuid
  product_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@map("favorites")
}

model Order {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id      String      @db.Uuid
  order_date   DateTime    @default(now()) @db.Timestamptz(6)
  total_amount Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  payment_id   String?     @unique @db.Uuid
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime    @default(now()) @db.Timestamptz(6)

  order_items OrderItem[]
  payment     Payment?
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id   String   @db.Uuid
  product_id String   @db.Uuid
  variant_id String?  @db.Uuid
  quantity   Int
  price      Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  order_id       String        @unique @db.Uuid
  amount         Decimal       @db.Decimal(10, 2)
  platform_fee   Decimal       @default(0.00) @db.Decimal(10, 2)
  seller_earning Decimal       @db.Decimal(10, 2)
  currency       String        @default("FCFA")
  method         String        @default("FedaPay")
  transaction_id String        @unique
  status         PaymentStatus @default(PENDING)
  paid_at        DateTime?     @db.Timestamptz(6)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)

  order  Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  splits PaymentSplit[]

  @@map("payments")
}

model PaymentSplit {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  payment_id      String   @db.Uuid
  shop_id         String   @db.Uuid
  amount          Decimal  @db.Decimal(10, 2)
  commission_rate Decimal  @db.Decimal(5, 4)
  platform_fee    Decimal  @db.Decimal(10, 2)
  seller_earning  Decimal  @db.Decimal(10, 2)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  shop    Shop    @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@index([shop_id])
  @@map("payment_splits")
}

model Withdrawal {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seller_id   String   @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  method      String   // ex: "MOMO", "BANK_TRANSFER"
  account     Json?    // détails du compte destinataire (numero, nom, banque, mobile operator...)
  status      String   @default("PENDING")
  processed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@index([seller_id])
  @@map("withdrawals")
}

model Review {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  product_id            String   @db.Uuid
  user_id               String   @db.Uuid
  rating                Int
  comment               String?
  is_verified_purchase  Boolean  @default(false)
  seller_reply          String?
  seller_reply_at       DateTime? @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@map("reviews")
}

model Notification {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String?  @db.Uuid
  type       String
  title      String
  message    String
  metadata   Json     @default("{}")
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AdminLog {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id       String?  @db.Uuid
  action        String
  resource_type String?
  resource_id   String?  @db.Uuid
  changes       Json     @default("{}")
  metadata      Json     @default("{}")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("admin_logs")
}

model SupportTicket {
  id          String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String                @db.Uuid
  subject     String
  description String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  category    SupportTicketCategory @default(OTHER)
  assigned_to String?               @db.Uuid
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @db.Timestamptz(6)
  resolved_at DateTime?             @db.Timestamptz(6)

  replies  SupportTicketReply[]
  user     User                 @relation("TicketRequester", fields: [user_id], references: [id], onDelete: Cascade)
  assignee User?                @relation("TicketAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@map("support_tickets")
}

model SupportTicketReply {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticket_id   String   @db.Uuid
  user_id     String   @db.Uuid
  message     String
  is_internal Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("support_ticket_replies")
}

model Report {
  id          String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String       @db.Uuid
  product_id  String?      @db.Uuid
  seller_id   String?      @db.Uuid
  reason      String
  description String?
  status      ReportStatus @default(PENDING)
  resolved_by String?      @db.Uuid
  resolution  String?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime     @default(now()) @db.Timestamptz(6)
  resolved_at DateTime?    @db.Timestamptz(6)

  reporter User     @relation("ReportCreator", fields: [user_id], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  seller   Seller?  @relation(fields: [seller_id], references: [id], onDelete: SetNull)
  admin    User?    @relation("ReportResolver", fields: [resolved_by], references: [id], onDelete: SetNull)

  @@map("reports")
}

model SystemAlert {
  id           String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  alert_type   String
  severity     SystemAlertSeverity @default(INFO)
  message      String
  metadata     Json                @default("{}")
  is_read      Boolean             @default(false)
  dismissed_at DateTime?           @db.Timestamptz(6)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)

  @@map("system_alerts")
}

model Setting {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key         String   @unique
  value       String
  description String?
  category    String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("settings")
}

model AdminOtpRateLimit {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String    @unique
  request_count    Int       @default(0)
  first_request_at DateTime  @default(now()) @db.Timestamptz(6)
  failed_attempts  Int       @default(0)
  blocked_until    DateTime? @db.Timestamptz(6)

  @@map("admin_otp_rate_limits")
}

model AdminOtp {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email      String
  code       String
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("admin_otps")
}

model ProcessedWebhook {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  transaction_id String   @unique
  processed_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("processed_webhooks")
}

model StoreMedia {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  shop_id       String?  @db.Uuid
  uploader_id   String?  @db.Uuid
  public_id     String   @unique
  url           String
  resource_type String
  format        String?
  width         Int?
  height        Int?
  bytes         Int?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  shop     Shop? @relation(fields: [shop_id], references: [id], onDelete: Cascade)
  uploader User? @relation(fields: [uploader_id], references: [id], onDelete: SetNull)

  @@map("store_media")
}
